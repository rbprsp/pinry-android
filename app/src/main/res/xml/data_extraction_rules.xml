<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the session (an API token that never expires) stays on this device. Settings may move. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
